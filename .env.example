# =============================================================
# web-login 환경 설정 예시
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 수정하세요.  (cp .env.example .env)
# =============================================================

# 로그인 서버 포트
PORT=3000

# TODO: 운영 환경에서는 반드시 길고 랜덤한 값으로 변경하세요.
#       예) node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# 세션 유지 시간(분)
SESSION_MAX_AGE_MINUTES=480

# HTTPS 로 서비스할 때 true (쿠키 Secure 플래그). 리버스 프록시 뒤라면 TRUST_PROXY=true 도 함께.
COOKIE_SECURE=false
TRUST_PROXY=false

# -------------------------------------------------------------
# Kibana 연결 설정
# -------------------------------------------------------------
# TODO: 내부망의 실제 Kibana 주소로 변경하세요. (지금은 임시 Mock Kibana: npm run mock:kibana)
KIBANA_URL=http://localhost:5601

# 이 서버에서 Kibana 를 프록시할 경로. Kibana 설정(kibana.yml)과 맞춰야 합니다.
#   server.basePath: "/kibana"
#   server.rewriteBasePath: true
KIBANA_BASE_PATH=/kibana

# TODO: 로그인 후 기본으로 이동할 페이지. (원래 요청한 페이지가 없을 때 사용)
#       - 상대경로(/kibana/app/...) : 이 서버의 프록시를 통해 Kibana 접속 (권장)
#       - 절대URL(http://kibana.internal:5601/app/home) : 아래 ALLOWED_REDIRECT_HOSTS 에 호스트 등록 필요
DEFAULT_REDIRECT=/kibana/app/home

# 절대 URL 리다이렉트를 허용할 호스트 목록 (콤마 구분, Open Redirect 방지용)
# TODO: 직접 리다이렉트 방식을 쓸 경우 Kibana 호스트를 등록하세요. 예) kibana.internal:5601
ALLOWED_REDIRECT_HOSTS=

# -------------------------------------------------------------
# DB 연결 설정
# -------------------------------------------------------------
# memory : 임시 사용자 저장소 (src/db/memoryUserStore.js) - 지금은 이걸로 동작
# TODO: 내부망 DB 연결 후 mysql / postgres 등으로 변경하고 src/db/index.js 에 구현 연결
DB_TYPE=memory

# TODO: 실제 DB 접속 정보로 변경하세요.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weblogin
DB_USER=weblogin
DB_PASSWORD=change-me
