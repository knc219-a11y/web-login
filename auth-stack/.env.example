# =============================================================
# auth-stack 환경 설정 (Keycloak + PostgreSQL + Spring 게이트웨이 + Redis)
# 사용법: cp .env.example .env  후 값 수정 → docker compose up -d
# =============================================================

# 사용자가 브라우저로 접속하는 주소 (끝에 / 없이). HAProxy 가 이 주소로 받습니다.
# TODO: 내부망에서는 실제 도메인으로 변경 (예: https://kibana.example.co.kr)
PUBLIC_URL=http://localhost:8000
PUBLIC_PORT=8000

# -------------------------------------------------------------
# Keycloak 관리자 (최초 기동 시에만 생성됨)
# -------------------------------------------------------------
# TODO: 반드시 변경. 관리 콘솔: ${PUBLIC_URL}/auth/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# -------------------------------------------------------------
# Keycloak DB (PostgreSQL)
# -------------------------------------------------------------
# TODO: 내부망에 이미 PostgreSQL 이 있다면 docker-compose.yml 의 postgres 서비스를 빼고
#       KC_DB_URL 을 그 서버로 바꾸세요. 예) jdbc:postgresql://10.0.0.10:5432/keycloak
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-db

# -------------------------------------------------------------
# Spring 게이트웨이 (gateway/)
# -------------------------------------------------------------
# Keycloak 의 kibana-gateway 클라이언트 비밀값 (realm 가져오기 때 이 값으로 등록됨)
# TODO: 변경. 예) openssl rand -hex 32
GATEWAY_CLIENT_SECRET=change-me-client-secret

# HTTPS 로 서비스하면 true (세션 쿠키 Secure). TODO: 운영은 true
COOKIE_SECURE=false

# -------------------------------------------------------------
# Kibana
# -------------------------------------------------------------
# TODO: 내부망 실제 Kibana 주소. 지금은 임시 Mock Kibana 컨테이너.
#       Kibana 쪽 kibana.yml 에 server.basePath: "/kibana", server.rewriteBasePath: true 필요
KIBANA_URL=http://mock-kibana:5601
